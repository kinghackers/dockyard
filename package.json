{
  "name": "dockyard",
  "productName": "Dockyard",
  "version": "0.2.2",
  "description": "多主机 Docker 管理客户端 / Multi-host Docker manager",
  "author": "Dockyard",
  "license": "MIT",
  "homepage": "https://gitee.com/kinghackers/dockyard",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kinghackers/dockyard.git"
  },
  "bugs": {
    "url": "https://gitee.com/kinghackers/dockyard/issues"
  },
  "main": "dist-electron/main.js",
  "private": false,
  "scripts": {
    "start": "electron dist-electron/main.js",
    "dev": "concurrently -k \"vite\" \"node scripts/dev-electron.mjs\"",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:compat": "npm run build && electron-builder --win --config.asar=false --config.directories.output=out --config.electronDist=node_modules/electron/dist --config.win.signAndEditExecutable=false",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:logic": "node scripts/check-logic.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:ipc && npm run check:logic && npm run check:i18n && npm run e2e",
    "verify:dist": "npm run build && npm run verify && npm run check:dist",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.4",
    "lucide-react": "^0.462.0",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-builder@25.1.8": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  },
  "build": {
    "publish": null,
    "appId": "com.dockyard.dockyard",
    "productName": "Dockyard",
    "copyright": "Copyright © 2026 Dockyard",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ssh2/**",
      "**/node_modules/cpu-features/**",
      "**/node_modules/dockerode/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dockyard-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Dockyard-${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Dockyard-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "kinghackers <kinghackers@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Dockyard-${version}-${arch}.${ext}"
    }
  }
}
