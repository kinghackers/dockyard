{
  "name": "docker-manager",
  "productName": "Docker 管理器",
  "version": "0.1.0",
  "description": "多主机 Docker 管理客户端",
  "author": "Dockyard",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron dist-electron/main.js",
    "dev": "concurrently -k \"vite\" \"node scripts/dev-electron.mjs\"",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:logic": "node scripts/check-logic.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run typecheck && npm run check:ipc && npm run check:logic",
    "verify:dist": "npm run build && npm run verify && npm run check:dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.4",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-builder@25.1.8": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  },
  "build": {
    "appId": "com.dockyard.docker-manager",
    "productName": "Docker 管理器",
    "copyright": "Copyright © 2026 Dockyard",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ssh2/**",
      "**/node_modules/cpu-features/**",
      "**/node_modules/dockerode/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "sign": null,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "artifactName": "DockerManager-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DockerManager-${version}-Setup.${ext}"
    }
  }
}
